# Optional override for a separately deployed backend.
# Leave VITE_API_BASE_URL unset for local development and GitHub Codespaces:
# Vite proxies same-origin /api requests to Flask at http://127.0.0.1:5000.
# A nonempty override bypasses the development proxy.
# VITE_API_BASE_URL=https://your-deployed-backend.example.com

# Report a Fire (#51) only sends reports when this is "true". Leave it unset
# until POST /api/reports (#52) is merged; the form then runs as a preview.
# VITE_ENABLE_REPORTS=true

# Copy this file to frontend/.env.local to override it (.env.local is git-ignored).
# Vite reads it when you run `npm run dev` or `npm run build`.
#
# URL of the Flask backend. If this is not set, http://127.0.0.1:5000 is used.
# This is a public URL, not a secret, but keep it out of the source code.
# The backend must also allow this site's origin: see CORS_ORIGINS in backend/.env.example.
# VITE_API_BASE_URL=https://your-backend.example.com

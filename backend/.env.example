# Copy this file to backend/.env and fill in the real values. Never commit .env.
#
# Supabase dashboard -> project "ash-detectives" -> Connect -> "Session pooler"
# (the session pooler works on all networks; the "Direct connection" is IPv6-only).
# Copy the exact string shown there (the host below is only an example) and
# replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.cfkfuyhnmgijbwdyyhvk:[YOUR-PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:5432/postgres

# Only needed for data-processing/fetch_firms_nrt.py (recent fire detections).
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# FIRMS_MAP_KEY=your-map-key

# Optional: override the detection confidence threshold (0-100), see backend/config.py
# MIN_DETECTION_CONFIDENCE=30

# Optional: browser origin(s) allowed to call this API, comma-separated.
# Default is the local dev server (http://localhost:5173). Set it to your deployed site's address.
# CORS_ORIGINS=https://your-frontend.example.com
